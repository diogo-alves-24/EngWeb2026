extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Atores
    
    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th Nome
          th Nº Filmes

        each ator in atores
          tr
            td
              a(href="/atores/" + encodeURIComponent(ator[0]))= ator[0]
            td= ator[1]

              