extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Generos
    
    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th Genero
          th Nº Filmes

        each gen in generos
          tr
            td
              a(href="/generos/" + encodeURIComponent(gen[0]))= gen[0]
            td= gen[1]

              