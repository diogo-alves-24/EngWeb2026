extends layout

block content
  .w3-card-4
    header.w3-container.w3-purple
      h2= e.nome.primeiro + ' ' + e.nome.último

    p Data: #{e.dataEMD}
    p Idade: #{e.idade}
    p Género: #{e.genero}
    p Morada: #{e.morada}
    p Modalidade: #{e.modalidade}
    p Clube: #{e.clube}
    p Email: #{e.email}
    p Federado: #{e.federado ? "Sim" : "Não"}
    p Resultado: #{e.resultado ? "Passou" : "Não Passou"}

    a(href='/') Voltar 
    
    

    