extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 EMD Records List 
        a.w3-btn.w3-round.w3-grey(href="/emd/registo") +
    
    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th Nome
          th Data
          th Modalidade
          th Resultado
        each t in list
          tr
            td 
              a(href=`/emd/${t.id}`)=t.nome.primeiro + ' ' + t.nome.último
            td= t.dataEMD
            td= t.modalidade
            td= t.resultado ? "Passou" : "Não Passou"
            td
              a.w3-btn.w3-round.w3-blue-grey.w3-small(href=`/emd/editar/${t.id}`) Edit
              a.w3-btn.w3-round.w3-red.w3-small.w3-margin-left(href=`/emd/apagar/${t.id}`) Delete
              