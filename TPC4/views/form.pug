extends layout

block content
  .w3-card-4
    header.w3-container.w3-purple
      h2= treino ? "Edit EMD Record" : "New EMD Record"
    
    form.w3-container.w3-padding-16(method="POST" action=treino ? `/emd/${treino.id}` : "/emd")
      fieldset
        legend Metadata
        if treino
          input(type="hidden" name="id" value=treino.id)
        
        label Data
        input.w3-input.w3-round(type="text" name="data" value=treino ? treino.dataEMD : "")
        
        label Nome
        input.w3-input.w3-round(type="text" name="nome" value=treino ? treino.nome.primeiro + " " + treino.nome.último : "")
        
        label Modalidade
        input.w3-input.w3-round(type="text" name="modalidade" value=treino ? treino.modalidade : "")
        
        label Resultado
        input.w3-input.w3-round(type="text" name="resultado" value=treino ? treino.resultado : "")
      
      button.w3-btn.w3-purple.w3-margin-top(type="submit")= treino ? "Update" : "Insert"
      a.w3-btn.w3-grey.w3-margin-top.w3-margin-left(href="/") Cancel