extends layout.pug

block content
  .w3-container
    h2 Lista de Filmes (#{filmes.length})

    table.w3-table-all
      tr.w3-teal
        th Título
        th Ano
        th Nº de Atores
        th Nº de Géneros

      each f in filmes
        tr
          td
            a(href=`/filmes/${f._id}`)= f.title
          td= f.year
          td= f.cast.length
          td= f.genres.length